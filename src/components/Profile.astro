---
import { COVER, FACE } from "../lib/portrait-art.ts";
import PortraitScript from "./PortraitScript.astro";

// The Me page, laid out like an online profile (Twitter, LinkedIn, an old Facebook page): a banner
// of code across the top, a small round picture on the left overlapping the banner's lower edge,
// the actions on the right of the same row, then the name, headline and status underneath. The
// phone layout is the same, only smaller. The page's sections go in the slot as further cards.
// Both pictures are decoration: the script draws them, and nothing is lost without them. The
// drawing itself is src/scripts/portrait.ts.
interface Props {
  name: string;
  headline: string;
  status: string;
}

const { name, headline, status } = Astro.props;
---

<div class="profile">
  <section class="profile-card profile-top" aria-labelledby="profile-name">
    <div class="profile-cover">
      <div
        class="portrait"
        data-portrait
        data-kind="cover"
        data-tone={COVER.tone}
        data-cols={COVER.cols}
        data-rows={COVER.rows}
        data-cells={COVER.cells.join("")}
        aria-hidden="true"
      >
      </div>
    </div>
    <div class="profile-id">
      <div class="profile-photo" aria-hidden="true">
        <div
          class="portrait"
          data-portrait
          data-kind="face"
          data-tone={FACE.tone}
          data-cols={FACE.cols}
          data-rows={FACE.rows}
          data-cells={FACE.cells.join("")}
        >
        </div>
      </div>
      <div class="profile-text">
        <h1 id="profile-name">{name}</h1>
        <p class="headline">{headline}</p>
        <p class="label profile-status">{status}</p>
      </div>
      <p class="profile-actions">
        <a class="btn" href="/contact/">Get in touch</a>
        <a class="btn" href="https://notes.jarrettd.com/">Notes</a>
      </p>
    </div>
  </section>
  <slot />
</div>

<style is:global>
  .profile {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }

  .profile-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
  }

  .profile-card h2 {
    margin-top: 0;
  }

  .profile-card > :last-child {
    margin-bottom: 0;
  }

  .profile-top {
    padding: 0;
    overflow: hidden;
  }

  /* The banner keeps the shape of its art (5.4 x 12 px cells), so nothing moves when it is drawn.
     On a phone the art is drawn wider than the screen and cropped, so its symbols stay legible. */
  .profile-cover {
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .profile-cover .portrait {
    width: 100%;
    aspect-ratio: 864 / 168;
  }

  .profile-id {
    --photo: 10rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-3);
    padding: 0 var(--space-4) var(--space-4);
  }

  /* Round, half over the banner, ringed in the card's colour so it reads as its own thing. The
     art is a whole head, taller than wide: it takes most of the circle's width and is centred,
     so the whole head sits inside the ring. */
  .profile-photo {
    position: relative;
    width: var(--photo);
    height: var(--photo);
    margin-top: calc(var(--photo) / -2);
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg);
    border: 4px solid var(--surface);
    outline: 1px solid var(--border);
  }

  .profile-photo .portrait {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 85%;
    aspect-ratio: 388.8 / 552;
  }

  .profile-actions {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    align-self: start;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    max-width: none;
  }

  .profile-text {
    grid-column: 1 / -1;
    grid-row: 2;
    padding-top: var(--space-3);
    min-width: 0;
  }

  .profile-text h1 {
    margin: 0;
  }

  .headline {
    margin: var(--space-1) 0 0;
    font-size: 1.1rem;
  }

  .profile-status {
    margin: var(--space-2) 0 0;
    color: var(--accent-text);
  }

  .profile .rows {
    margin-bottom: 0;
  }

  .profile .tags {
    margin: 0;
    padding: 0;
  }

  .profile .tags li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  @media (max-width: 40rem) {
    .profile-cover .portrait {
      width: 150%;
    }

    .profile-card {
      padding: var(--space-3);
    }

    .profile-top {
      padding: 0;
    }

    .profile-id {
      --photo: 7rem;
      padding: 0 var(--space-3) var(--space-3);
    }

    .profile-actions .btn {
      padding: var(--space-2) 0.75rem;
      font-size: 0.875rem;
    }

    .profile-photo {
      border-width: 3px;
    }

    .profile-text {
      padding-top: var(--space-2);
    }
  }
</style>

<PortraitScript />
