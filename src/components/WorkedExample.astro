---
import raw from "../data/osint-pivot-map.json";
import { type PivotData, plural } from "../lib/pivot-map.ts";

const data = raw as PivotData;
const byId = new Map(data.nodes.map((n) => [n.id, n]));

// A made-up case, walked along real pivots: each step is looked up in the map's data when the
// site is built, so a pivot that leaves the guide breaks the build instead of the example.
const steps = [
  {
    from: "domain",
    to: "org",
    match: "Registrar",
    say: "The domain is a one-page shop that appeared last month. Its registration may name nobody today, but the history can show who held it before privacy was switched on.",
  },
  {
    from: "org",
    to: "name",
    match: "Read officers",
    say: "The registrant is a company. Registries list who it was incorporated by and who signs its filings, and those are public records.",
  },
  {
    from: "name",
    to: "org",
    match: "Check ownership",
    say: "One name appears twice. Checking ownership and sanctions records shows whether it sits behind other companies that matter to the question.",
  },
];
const found = steps.map((s) => {
  const edge = data.edges.find(
    (e) => e.from === s.from && e.to === s.to && e.label.startsWith(s.match),
  );
  if (!edge)
    throw new Error(`The worked example has no pivot ${s.from} to ${s.to} (${s.match}) in the map`);
  return { ...s, edge };
});
const trail = [found[0]?.from ?? "", ...found.map((s) => s.to)];
---

<section class="example" aria-labelledby="example-title">
  <h2 id="example-title">How to use it</h2>
  <ol class="use">
    <li><b>Pick what you hold.</b><span>A domain, a name, an email, a photo. Choose it on the map.</span></li>
    <li><b>Follow a pivot.</b><span>Each pivot leads to something new you can reach from it.</span></li>
    <li><b>Open a tool.</b><span>Every pivot names its tools. Start with the ones tagged start.</span></li>
    <li><b>Log and check.</b><span>Capture the page, note the time, confirm with a second source.</span></li>
  </ol>
  <h3>A worked example</h3>
  <p>
    A made-up case: you are asked whether a new online shop, <code>shop.example</code>, is run by a
    real business. It starts from a domain and takes {plural(found.length, "pivot")}.
  </p>
  <p class="trail" aria-label="The trail">
    {trail.map((id, i) => (<>{i > 0 && <span aria-hidden="true">&rarr;</span>}<b>{byId.get(id)?.short}</b></>))}
  </p>
  <ol class="rows">
    {
      found.map((s, i) => (
        <li>
          <p class="label">
            Step {i + 1}: {byId.get(s.from)?.short} to {byId.get(s.to)?.short}
          </p>
          <p>{s.say}</p>
          <p><b>The pivot:</b> {s.edge.label}</p>
          <ul class="tl" aria-label="Tools for this pivot">
            {s.edge.tools.map((t) => <li>{t.name}</li>)}
          </ul>
        </li>
      ))
    }
  </ol>
  <p>
    <a href={`#${trail.join(".")}`}>Replay this trail on the map</a> and copy it as Markdown or as
    a link. Every step gets the same treatment: capture the page, log the time, and check it
    against a second source before it counts. The end is not a verdict: it is a list of claims,
    each with a source and a time.
  </p>
</section>
