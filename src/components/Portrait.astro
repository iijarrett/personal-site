---
import { MARK } from "../lib/portrait-art.ts";
import PortraitScript from "./PortraitScript.astro";

// The JD mark, drawn behind the Contact page's tiles like a signature: it sits at the bottom
// right of the block and shows through the tiles. Decoration only: the script draws it, and
// nothing is lost without it. Put it first inside a `.channels-wrap`, before the tiles.
---

<div
  class="portrait portrait-back"
  data-portrait
  data-kind="mark"
  data-tone={MARK.tone}
  data-cols={MARK.cols}
  data-rows={MARK.rows}
  data-cells={MARK.cells.join("")}
  aria-hidden="true"
>
</div>

<style is:global>
  /* The block's bottom padding is the room the mark hangs into below the tiles. */
  .channels-wrap {
    position: relative;
    max-width: 44rem;
    margin: var(--space-4) 0 var(--space-5);
    padding-bottom: 6.5rem;
  }

  .channels-wrap .channels {
    position: relative;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin: 0;
  }

  /* The tiles are a little see-through, so the mark's top edge shows behind the last tile. */
  .channels-wrap .channels li {
    background: color-mix(in srgb, var(--surface) 55%, transparent);
  }

  /* A small signature at the bottom right: made for 5.4 x 12 px cells, drawn at a fraction of
     that. It hangs below the tiles and only touches the last one's lower edge, clear of its text.
     Its edges fade out so the field of symbols has no hard border. */
  .channels-wrap .portrait-back {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(12rem, 45%);
    aspect-ratio: 388.8 / 264;
    pointer-events: none;
    mask-image:
      linear-gradient(to right, transparent, #000 6%, #000 94%, transparent),
      linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent);
    mask-composite: intersect;
  }

  @media (max-width: 48rem) {
    .channels-wrap {
      padding-bottom: 6rem;
    }

    .channels-wrap .portrait-back {
      width: min(10rem, 42%);
    }
  }
</style>

<PortraitScript />
