---
import Portrait from "../components/Portrait.astro";
import Page from "../layouts/Page.astro";
---

<Page title="Me" description="Background, skills and experience.">
  <Portrait kind="face">
    <h1>Me</h1>
    <p>Placeholder resume. Replace each section with real content before launch.</p>

    <h2>Summary</h2>
    <p>
      A short paragraph on what I do, what I am studying and the kind of role I am looking for.
    </p>

    <h2>Experience</h2>
    <ul class="rows">
      <li>
        <p class="label">Dates</p>
        <h3>Role, organisation</h3>
        <p>One or two lines on scope and outcome.</p>
      </li>
    </ul>

    <h2>Education</h2>
    <ul class="rows">
      <li>
        <p class="label">Dates</p>
        <h3>Programme, institution</h3>
      </li>
    </ul>

    <h2>Skills</h2>
    <ul class="tags" aria-label="Skills">
      <li>networking</li>
      <li>linux</li>
      <li>windows</li>
      <li>scripting</li>
    </ul>
  </Portrait>
</Page>
