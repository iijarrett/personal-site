{
  "name": "personal-site",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test": "node --test tests/",
    "check:dist": "python scripts/check_dist.py && python scripts/check_headers.py",
    "verify": "npm run check && npm run lint && npm run test && npm run build && npm run check:dist"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.4",
    "astro": "7.4.4",
    "typescript": "6.0.3"
  }
}
